{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev",
    ".open-next",
    ".wrangler",
    "SolveSprint-Sanitized-Review",
    "SolveSprint-Sanitized-Review/**/*",
    "SolveSprint-PostRemediation-Review",
    "SolveSprint-PostRemediation-Review/**/*",
    "SOLVESPRINT_AUDIT_VERIFICATION_BUNDLE",
    "SOLVESPRINT_AUDIT_VERIFICATION_BUNDLE/**/*"
  ]
}
